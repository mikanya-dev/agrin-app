# Supabase 設定
# https://supabase.com で新規プロジェクトを作成して、Project SettingsからAPI URLとAnonキーを取得
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# セキュアな AI API プロキシ（本番推奨）
# Cloud Functions（Firebase/Google Cloud）で以下のエンドポイントをデプロイしてください
# → src/functions/callGemini.js を参照
VITE_AI_PROXY_URL=https://your-region-your-project.cloudfunctions.net/callGemini

# Gemini API キー（開発・フォールバック用のみ）
# ⚠️ 本番環境では使用しないこと - プロキシ経由を使用
VITE_GEMINI_API_KEY=your-gemini-api-key

# Google Maps API キー
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# LINE LIFF ID
VITE_LIFF_ID=your-line-liff-id

# アプリID
VITE_APP_ID=yugawara-farmer-app

# デバッグモード
VITE_DEBUG=false
